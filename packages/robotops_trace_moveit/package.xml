<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotops_trace_moveit</name>
  <version>0.3.1</version>
  <description>
    RobotOps Trace integration for MoveIt: captures the active trace context when a
    trajectory is enqueued on MoveIt's TrajectoryExecutionManager and restores it
    on the execution thread, so the controller hop (FollowJointTrajectory) nests
    under move_action across MoveIt's internal queue boundary — the one residual
    async case with no public hook. Ships a reusable, MoveIt-agnostic
    capture/restore helper (TrajectoryExecutionTracer) plus a carried patch wiring
    it into stock moveit_ros_planning (the ★ async patch, carried until upstreamed).
    Built on the robotops_trace_cpp SDK core.
  </description>

  <maintainer email="kristophm@robotops.com">Kristoph Matthews</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- RobotOps SDK core + shared semantic conventions. The core's async-context
       API (capture_context/ScopedContext, ROB-443) ships in 0.3.0, so this
       package requires >=0.3.0. A core major bump fans out a coordinated bump
       here (see spec 2.5). -->
  <depend version_gte="0.3.0">robotops_trace_cpp</depend>
  <depend version_gte="0.1.0">robotops_trace_semconv</depend>

  <!-- The MoveIt-agnostic helper library declares NO MoveIt deps on purpose.
       It includes no MoveIt header and the CMakeLists does not find_package any
       MoveIt package, so it builds with only the trace deps above. We deliberately
       do NOT depend on moveit_ros_planning here: the carried TEM patch (patches/)
       is applied to stock moveit_ros_planning, and when that patched package is
       built in the SAME colcon workspace as this helper (e.g. xarm_demo's
       STITCH_PATCHES=1 lane), a `<depend>moveit_ros_planning</depend>` would form a
       circular dependency (moveit_ros_planning -> robotops_trace_moveit ->
       moveit_ros_planning) that colcon cannot topologically order. MoveIt enters
       only via the patch, which resolves its own MoveIt deps from apt. -->
  <!-- (none) -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
