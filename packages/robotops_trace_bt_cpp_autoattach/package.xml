<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotops_trace_bt_cpp_autoattach</name>
  <version>0.1.0</version>
  <description>
    Process-wide LD_PRELOAD auto-attach for BehaviorTree.CPP (ROB-451): interposes
    BT::BehaviorTreeFactory::createTree* to attach a robotops_trace_bt_cpp
    TreeTracer to every tree the process builds — so STOCK Nav2 bt_navigator emits
    BT-node spans with zero code changes and no fork. BehaviorTree.CPP v4 (jazzy).
  </description>

  <maintainer email="kristophm@robotops.com">Kristoph Matthews</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- SDK core (init/spans) + the TreeTracer we attach. Pinned to their current
       minors; a core major bump fans out a coordinated bump here. -->
  <depend version_gte="0.1.0">robotops_trace_cpp</depend>
  <!-- Needs the PIC-enabled bt_cpp (0.3.0+) so its lib links into this SHARED object. -->
  <depend version_gte="0.3.0">robotops_trace_bt_cpp</depend>

  <!-- Target framework: we interpose its factory + attach to its trees. -->
  <depend>behaviortree_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
